# Audio
CONFIG_SND_SOC_DBMDX=y
CONFIG_SND_SOC_DBMDX_SND_CAPTURE=y
CONFIG_SND_SOC_FS16XX=y

# DTB/O
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="tinno/c330ae"
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# NFC
CONFIG_NFC_CXD224X=y
CONFIG_NFC_CXD224X_RST=y
CONFIG_NFC_DEVICES=y

# No system-as-root
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# Project
CONFIG_MACH_TINNO_C330AE=y
CONFIG_C330AE_FASTBOOT_KEY=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Sensors
CONFIG_HALL_SENSOR=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_FT8006P_C330AE=y

# WLAN
CONFIG_ENABLE_LINUX_REG=y
CONFIG_PRIMA_WLAN_11AC_HIGH_TP=y
CONFIG_PRIMA_WLAN_LFR=y
CONFIG_PRIMA_WLAN_OKC=y
CONFIG_PRONTO_WLAN=y
CONFIG_QCOM_TDLS=y
CONFIG_QCOM_VOWIFI_11R=y
CONFIG_WLAN_FEATURE_11W=y
CONFIG_WLAN_OFFLOAD_PACKETS=y
